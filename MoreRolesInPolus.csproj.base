<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<RootNamespace>Toa</RootNamespace>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>12.0</LangVersion>
		<OutputType>Library</OutputType>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
		<EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
		<!-- MonoMod.Utils が同じ属性を公開しているため、生成を省略して重複（CS0436）を避ける -->
		<IgnoresAccessChecksToOmitAttributeDefinition>true</IgnoresAccessChecksToOmitAttributeDefinition>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="IgnoresAccessChecksToGenerator" Version="1.0.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="NebulaAPI" Version="11.0.0" />
	</ItemGroup>
	
	<ItemGroup>
		<!-- dobby.dll はネイティブ DLL なので参照から除外（MSB3246） -->
		<Reference Include="$(AmongUs)\BepInEx\core\*.dll" Exclude="$(AmongUs)\BepInEx\core\dobby.dll" />
		<Reference Include="$(AmongUs)\BepInEx\interop\*.dll" />
		<Reference Include="Nebula">
			<HintPath>$(AmongUs)\BepInEx\nebula\Nebula.dll</HintPath>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<IgnoresAccessChecksTo Include="Nebula" />
		<IgnoresAccessChecksTo Include="NebulaAPI" />
	</ItemGroup>

	<PropertyGroup>
		<AddonRoot>$(MSBuildProjectDirectory)\MoreRolesInPolus</AddonRoot>
		<!-- Debugビルド時のAmong Us起動回数（デフォルト：1） -->
		<LaunchCount Condition="'$(LaunchCount)' == ''">1</LaunchCount>
	</PropertyGroup>

	<ItemGroup>
		<!-- IntelliSense用 -->
		<Compile Include="$(AddonRoot)\Scripts\**\*.cs" />
		<Compile Include="$(AddonRoot)\*.cs" />

		<!-- 表示用 -->
		<None Include="$(AddonRoot)\**\*.*" Exclude="$(AddonRoot)\**\*.cs" />
	</ItemGroup>

	<!-- Debug：mod開発用ファイルにzip作成+1回起動 -->
	<Target Name="DebugBuild" AfterTargets="Build" Condition="'$(Configuration)'=='Debug'">
		<PropertyGroup>
			<TempZipDir>$(MSBuildProjectDirectory)\temp_zip</TempZipDir>
			<ZipFileName>[junjun]MoreRolesInPolus.zip</ZipFileName>
			<SteamAddonsPath>$(AmongUs)\Addons</SteamAddonsPath>
		</PropertyGroup>
		
		<RemoveDir Directories="$(TempZipDir)" Condition="Exists('$(TempZipDir)')" />
		<MakeDir Directories="$(TempZipDir)" />
		
		<ItemGroup>
			<AddonFiles Include="$(AddonRoot)\**\*.*" />
		</ItemGroup>
		
		<Copy SourceFiles="@(AddonFiles)" DestinationFolder="$(TempZipDir)\%(RecursiveDir)" />
		<ZipDirectory SourceDirectory="$(TempZipDir)" DestinationFile="$(SteamAddonsPath)\$(ZipFileName)" Overwrite="true" />
		<RemoveDir Directories="$(TempZipDir)" />
		
		<Message Text="Debugビルド完了: $(SteamAddonsPath)\$(ZipFileName)" Importance="high" />
		
		<!-- Among Us を起動（LaunchCount回、4秒間隔） -->
		<Exec Condition="$(LaunchCount) &gt; 0" Command="powershell -Command &quot;1..$(LaunchCount) | ForEach-Object { Start-Process '$(AmongUs)\Among Us.exe'; if ($_ -lt $(LaunchCount)) { Start-Sleep -Seconds 4 } }&quot;" />
		<Message Condition="$(LaunchCount) &gt; 0" Text="Among Us を $(LaunchCount) 回起動しました（4秒間隔）" Importance="high" />
	</Target>

	<!-- Release：bin\Release + NoS_dev（配布用にプレフィックスなし） -->
	<Target Name="ReleaseBuild" AfterTargets="Build" Condition="'$(Configuration)'=='Release'">
		<PropertyGroup>
			<TempZipDir>$(MSBuildProjectDirectory)\temp_zip</TempZipDir>
			<ZipFileName>MoreRolesInPolus.zip</ZipFileName>
			<SteamAddonsPath>$(AmongUs)\Addons</SteamAddonsPath>
			<BinReleasePath>$(MSBuildProjectDirectory)\bin\Release</BinReleasePath>
		</PropertyGroup>
		
		<RemoveDir Directories="$(TempZipDir)" Condition="Exists('$(TempZipDir)')" />
		<MakeDir Directories="$(TempZipDir)" />
		<MakeDir Directories="$(BinReleasePath)" Condition="!Exists('$(BinReleasePath)')" />
		
		<ItemGroup>
			<AddonFiles Include="$(AddonRoot)\**\*.*" />
		</ItemGroup>
		
		<Copy SourceFiles="@(AddonFiles)" DestinationFolder="$(TempZipDir)\%(RecursiveDir)" />
		
		<!-- bin\Releaseにzip -->
		<ZipDirectory SourceDirectory="$(TempZipDir)" DestinationFile="$(BinReleasePath)\$(ZipFileName)" Overwrite="true" />
		<!-- NoS_devにzip -->
		<ZipDirectory SourceDirectory="$(TempZipDir)" DestinationFile="$(SteamAddonsPath)\$(ZipFileName)" Overwrite="true" />
		
		<RemoveDir Directories="$(TempZipDir)" />
		
		<Message Text="Releaseビルド完了: $(BinReleasePath)\$(ZipFileName) と $(SteamAddonsPath)\$(ZipFileName)" Importance="high" />
	</Target>

</Project>
